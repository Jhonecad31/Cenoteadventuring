---
export const prerender = false;
import BlogPost from "@/components/blog/BlogPost.astro";
import { getPostBySlug } from "@/lib/blog";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

// Modo preview: permite ver borradores cuando se pasa ?preview=true desde el CMS
const isPreview = Astro.url.searchParams.get('preview') === 'true';

const { currentLocale } = Astro;
const post = await getPostBySlug(slug, undefined, undefined, isPreview, currentLocale);

if (!post) {
  return Astro.redirect('/404');
}
---

<BlogPost post={post} />
