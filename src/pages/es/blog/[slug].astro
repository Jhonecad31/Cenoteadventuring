---
import BlogPost from "@/components/blog/BlogPost.astro";
import { getPostBySlug } from "@/lib/blog";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/es/404');
}

const post = await getPostBySlug(slug);

if (!post) {
  return Astro.redirect('/es/404');
}
---

<BlogPost post={post} />
