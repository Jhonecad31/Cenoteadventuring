---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AwardsPage from "@/components/segments/Awards.astro"
import { getI18N } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;

const seoMetaData = {
    title: i18n.SEO.AWARDS_PAGE.TITLE,
    description: i18n.SEO.AWARDS_PAGE.DESCRIPTION,
};
---

<BaseLayout seo={seoMetaData}>
    <AwardsPage/>
</BaseLayout>