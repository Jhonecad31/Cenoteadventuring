---
import SchemasSERP from "@/components/global/SchemasSERP.astro";
import Footer from "@/components/segments/Footer.astro";
import Head from "@/components/segments/Head.astro";
import Header from "@/components/segments/Header.astro";
import { getLangFromUrl } from "@/i18n/utils";
import '@/styles/global.css';

const lang = getLangFromUrl(Astro.url);
const { seo, offI18n, showFooter = true, bodyClass = "bg-[#EDF4FC]"} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <Head offI18n={offI18n} {...seo} />
        <SchemasSERP />
        <slot name="schema-jsonld" />
    </head>
    
    <body id="body" class={`${bodyClass} font-sans antialiased text-[#001524] overflow-x-hidden w-full`}>
        
        <noscript>
            <iframe 
                src="https://www.googletagmanager.com/ns.html?id=GTM-NV35K8DZ" 
                height="0" 
                width="0" 
                style="display:none;visibility:hidden">
            </iframe>
        </noscript>

        <Header offI18n={offI18n} />

        <main class="min-h-screen w-full relative">
            <slot />
        </main>

        {showFooter && <Footer />} </body>

        <style is:global>
            html, body {
                max-width: 100vw;
                overflow-x: hidden;
            }
            body {
                text-rendering: optimizeLegibility;
                -webkit-font-smoothing: antialiased;
            }
        </style>
    </body>
</html>