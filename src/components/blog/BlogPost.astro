---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { BlogPost } from "@/lib/blog";
import { getLangFromUrl } from "@/i18n/utils";
import TagH1 from "@/components/global/TagH1.astro";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const formattedDate = new Date(post.postDate).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const seoMetaData = {
  title: post.seoData?.seoTitle || post.postTitle,
  description: post.seoData?.metaDescription || post.postExcerpt,
  image: post.seoData?.ogImage,
};
---

<BaseLayout {...seoMetaData}>
  <article class="bg-white pt-32 pb-20 min-h-screen">
    <header class="max-w-4xl mx-auto px-6 mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-xs font-bold uppercase tracking-widest text-[#006083] bg-[#006083]/5 px-3 py-1 rounded-full">
          {post.tableName.replace(/_/g, ' ')}
        </span>
        <span class="text-xs text-slate-400 uppercase tracking-widest">
          {formattedDate}
        </span>
      </div>
      
      <TagH1 class="font-serif md:text-5xl lg:text-6xl mb-8 leading-tight">
        {post.postTitle}
      </TagH1>

      {post.seoData?.ogImage && (
        <div class="rounded-[2.5rem] overflow-hidden shadow-2xl mb-12 aspect-video">
          <img 
            src={post.seoData.ogImage} 
            alt={post.postTitle} 
            class="w-full h-full object-cover"
          />
        </div>
      )}
    </header>

    <div class="max-w-3xl mx-auto px-6">
      <div class="prose prose-slate prose-lg lg:prose-xl max-w-none 
        prose-headings:font-serif prose-headings:text-[#001524] 
        prose-p:text-slate-600 prose-p:leading-relaxed
        prose-a:text-[#006083] prose-a:no-underline hover:prose-a:underline
        prose-img:rounded-3xl prose-img:shadow-lg"
        set:html={post.postContent} 
      />
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* Estilos adicionales para el contenido del blog si es necesario */
  .prose img {
    margin-left: auto;
    margin-right: auto;
  }
</style>
