---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { BlogPost } from "@/lib/blog";
import { getI18N } from "@/i18n";
import { getLangFromUrl, useTranslatedPath } from "@/i18n/utils";
import TagH1 from "@/components/global/TagH1.astro";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { currentLocale: lang } = Astro;
const i18n = getI18N({ currentLocale: lang }) as any;
const translatePath = useTranslatedPath(lang);

const formattedDate = new Date(post.postDate).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const seoMetaData = {
  title: post.seoData?.seoTitle || post.postTitle,
  description: post.seoData?.metaDescription || post.postExcerpt,
  image: post.seoData?.ogImage,
};
---

<BaseLayout {...seoMetaData}>
  <article class="bg-white pt-32 pb-20 min-h-screen">
    <header class="max-w-4xl mx-auto px-6 mb-12">
      <a 
        href={translatePath('/blog/')}
        class="inline-flex items-center text-[#006083] font-bold text-xs uppercase tracking-widest mb-10 hover:gap-3 transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        {i18n.BLOG?.BACK || (lang === 'es' ? 'Volver' : 'Back')}
      </a>

      <div class="flex items-center gap-3 mb-6">
        <span class="text-xs text-slate-400 uppercase tracking-widest">
          {formattedDate}
        </span>
      </div>
      
      <TagH1 class="font-serif md:text-5xl lg:text-6xl mb-8 leading-tight">
        {post.postTitle}
      </TagH1>
      
    </header>

    <div class="max-w-3xl mx-auto px-6">
      <div class="prose prose-slate prose-lg lg:prose-xl max-w-none 
        prose-headings:font-serif prose-headings:text-[#001524] 
        prose-p:text-slate-600 prose-p:leading-relaxed
        prose-a:text-[#006083] prose-a:no-underline hover:prose-a:underline
        prose-img:rounded-3xl prose-img:shadow-lg"
        set:html={post.postContent} 
      />
    </div>
  </article>
</BaseLayout>

<style is:global>
  
  .prose img {
    margin-left: auto;
    margin-right: auto;
  }
</style>
