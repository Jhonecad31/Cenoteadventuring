---
import { Check } from "lucide-react";
import { Button } from "@/components/ui/button";
import { getI18N } from "@/i18n";
import { getLangFromUrl, useTranslatedPath } from "@/i18n/utils";
import TagH2 from "@/components/global/TagH2.astro";
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const cloudEndpoint = "https://ik.imagekit.io/pos7v26vx";
const getUrl = (id: string, w = 800) =>
  `${cloudEndpoint}/tr:w-${w},q-80,f-auto/${id}`;

const plans = [
  {
    id: "CENOTE",
    title: i18n.HOME_PAGE.CHOOSE_PLAN.PLANS.CENOTE.TITLE,
    description: i18n.HOME_PAGE.CHOOSE_PLAN.PLANS.CENOTE.DESCRIPTION,
    features: i18n.HOME_PAGE.CHOOSE_PLAN.PLANS.CENOTE.FEATURES,
    image: "/Cenote-Adventuring/CenoteA.7.webp",
    logo: "/Cenote-Adventuring/Logo-cenote.svg",
    price: 69,
    oldPrice: 79,
    href: translatePath("/cenotes-cancun/"),
  },
  {
    id: "PRIVATE",
    title: i18n.HOME_PAGE.CHOOSE_PLAN.PLANS.PRIVATE.TITLE,
    description: i18n.HOME_PAGE.CHOOSE_PLAN.PLANS.PRIVATE.DESCRIPTION,
    features: i18n.HOME_PAGE.CHOOSE_PLAN.PLANS.PRIVATE.FEATURES,
    image: "/Cenote-Adventuring/CenoteA.4.webp",
    logo: "/Cenote-Adventuring/Logo-cenote.svg",
    price: 69, 
    oldPrice: 79,
    href: translatePath("/cenote-cancun-private/"),
    priority: true,
    hide: true,
  },
];
---

<section class="bg-[#F8FAFC] py-16 md:py-24 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12 lg:mb-16">
      <TagH2 class="max-w-3xl mx-auto px-5 font-serif text-center! md:text-4xl">
        {i18n.HOME_PAGE.CHOOSE_PLAN.TITLE}
      </TagH2>
      <p class="text-[#001524]/60 max-w-4xl mx-auto text-center! px-5 lg:text-lg md:text-2xl mt-4">
        {i18n.HOME_PAGE.CHOOSE_PLAN.DESCRIPTION}
      </p>
    </div>

    <div class={`grid grid-cols-1 ${plans.filter(p => !p.hide).length > 1 ? 'lg:grid-cols-2' : ''} gap-10 lg:gap-16 justify-items-center`} id="plans">
      {plans.filter(plan => !plan.hide).map((plan) => (
        <div class="group bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl border border-slate-100 flex flex-col w-full max-w-[550px] transition-all duration-300 hover:-translate-y-2 hover:border-[#006083]/15">
          <div class="relative h-60 md:h-72 overflow-hidden">
            <img
              src={getUrl(plan.image, 600)}
              alt={plan.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute bottom-4 left-4 p-2 rounded-lg backdrop-blur-sm">
              <img
                src={`${cloudEndpoint}${plan.logo}`}
                alt="Logo"
                class="h-12 w-auto"
              />
            </div>
          </div>

          <div class="p-6 lg:p-8 flex flex-col gap-5 justify-between flex-grow">
            <div class="flex-1">
              <h3 class="font-serif text-2xl lg:text-3xl text-[#001524] mb-2">
                {plan.title}
              </h3>
              <p class="text-gray-600 mb-4 font-medium text-base lg:text-lg">
                {plan.description}
              </p>
              
              <ul class="hidden md:block space-y-3">
                {plan.features.map((feature: string) => (
                  <li class="flex items-center gap-2 text-sm lg:text-base text-gray-700">
                    <Check size={16} className="text-gray-400 shrink-0" />
                    {feature}
                  </li>
                ))}
              </ul>
            </div>

            <div class="w-full bg-gray-50/50 p-5 rounded-xl border border-gray-100 text-center">
              <div class="mb-4">
                <p class="text-xs lg:text-sm text-gray-400 line-through">
                  {i18n.DETAIL_PAGE.FORM_RESERVATION.PRICE_FROM} ${plan.oldPrice} USD
                </p>
                <div class="text-3xl lg:text-4xl font-bold text-[#001524]">
                  ${plan.price} USD
                </div>
                <p class="text-xs lg:text-sm text-gray-500">{i18n.DETAIL_PAGE.FORM_RESERVATION.PER_PERSON}</p>
              </div>

              <!-- GRID DE PROMOCIONES DE 3 COLUMNAS -->
              <div class="grid grid-cols-3 gap-2 mb-6">
  
                <!-- Tarjeta 1: 15% OFF -->
                <div class="bg-white p-2.5 sm:p-3 rounded-xl border border-gray-100 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between items-center text-center">
                  <div>
                    <span class="inline-block text-[10px] font-bold text-white bg-orange-500 rounded-full px-2 py-0.5 mb-1">
                      -15%
                    </span>
                    <p class="text-[10px] sm:text-[11px] leading-tight text-gray-500 font-medium">
                      {i18n.DETAIL_PAGE.FORM_RESERVATION.EARLY_BIRD.BOOKING_15_DAYS}
                    </p>
                  </div>
                  <p class="text-xs sm:text-base font-bold text-[#001524] mt-2">
                    ${Math.round(plan.price * 0.85)} <span class="text-[9px] sm:text-[10px] font-semibold text-gray-400">USD</span>
                  </p>
                </div>

                <!-- Tarjeta 2: 20% OFF -->
                <div class="bg-white p-2.5 sm:p-3 rounded-xl border border-gray-100 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between items-center text-center">
                  <div>
                    <span class="inline-block text-[10px] font-bold text-white bg-orange-500 rounded-full px-2 py-0.5 mb-1">
                      -20%
                    </span>
                    <p class="text-[10px] sm:text-[11px] leading-tight text-gray-500 font-medium">
                      {i18n.DETAIL_PAGE.FORM_RESERVATION.BOOKING_30_DAYS || i18n.DETAIL_PAGE.FORM_RESERVATION.EARLY_BIRD?.BOOKING_30_DAYS}
                    </p>
                  </div>
                  <p class="text-xs sm:text-base font-bold text-[#001524] mt-2">
                    ${Math.round(plan.price * 0.80)} <span class="text-[9px] sm:text-[10px] font-semibold text-gray-400">USD</span>
                  </p>
                </div>

                <!-- Tarjeta 3: 40% OFF -->
                <div class="bg-white p-2.5 sm:p-3 rounded-xl border border-gray-100 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between items-center text-center">
                  <div>
                    <span class="inline-block text-[10px] font-bold text-white bg-orange-500 rounded-full px-2 py-0.5 mb-1">
                      -40%
                    </span>
                    <p class="text-[10px] sm:text-[11px] leading-tight text-gray-500 font-medium">
                      {i18n.DETAIL_PAGE.FORM_RESERVATION.EARLY_BIRD.BOOKING_60_DAYS}
                    </p>
                  </div>
                  <p class="text-xs sm:text-base font-bold text-[#001524] mt-2">
                    ${Math.round(plan.price * 0.60)} <span class="text-[9px] sm:text-[10px] font-semibold text-gray-400">USD</span>
                  </p>
                </div>

              </div>

              <a 
                href={plan.href} 
                class="w-full block text-center bg-gradient-to-r from-[#006083] to-[#007EA8] hover:from-[#007EA8] hover:to-[#006083] text-white rounded-full text-sm lg:text-base py-3 lg:py-4 h-auto font-bold transition-all duration-300 shadow-md hover:shadow-lg hover:scale-[1.01]"
              >
                {i18n.DETAIL_PAGE.FORM_RESERVATION.BUTTON}
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>