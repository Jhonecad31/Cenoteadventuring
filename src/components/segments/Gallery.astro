---
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import TagH2 from "@/components/global/TagH2.astro";
import TagP from "@/components/global/TagP.astro";
import { getI18N } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const cloudEndpoint = "https://ik.imagekit.io/pos7v26vx";
const getUrl = (id: string, w = 800) =>
  `${cloudEndpoint}/tr:w-${w},q-80,f-auto/${id}`;

  //Se modifican las 
const images = {
  center: '/Cenote-Adventuring/CenoteA.5.webp',
  left: '/Cenote-Adventuring/CenoteA.1.webp',
  farLeft: '/Cenote-Adventuring/CenoteA.2.webp',
  right: '/Cenote-Adventuring/CenoteA.3.webp',
  farRightTop: '/Cenote-Adventuring/CenoteA.8.webp',
  farRightBottom: '/Cenote-Adventuring/CenoteA.7.webp',
};

const mobileSections = [
  { id: images.farLeft, size: "w-[75vw] h-[50vh]" },
  { id: images.left, size: "w-[60vw] h-[60vh]" },
  { id: images.center, size: "w-[65vw] h-[50vh]" },
  { id: images.right, size: "w-[65vw] h-[45vh]" },
  { id: images.farRightTop, size: "w-[70vw] h-[55vh]" },
];
---

<section class="py-12 bg-[#F8FAFC] w-full overflow-hidden">
  <TagH2 class="pt-20 max-w-3xl mx-auto px-5 font-serif text-center! md:text-4xl">
    {i18n.HOME_PAGE.GALLERY.TITLE}
  </TagH2>
  <TagP class="text-[#001524]/60 max-w-4xl mx-auto mb-10 md:mb-20 text-center! px-5 lg:text-lg md:text-2xl">
    {i18n.HOME_PAGE.GALLERY.DESCRIPTION}
  </TagP>

  <div class="hidden md:flex flex-row items-center justify-center gap-4 lg:gap-6 w-full px-4 min-h-[750px] py-10">
    
    <div class="hidden xl:flex flex-col gap-3 w-[150px] lg:w-[180px] shrink-0 translate-y-10">
      <div class="aspect-square rounded-md overflow-hidden shadow-sm cursor-zoom-in" data-fancybox="gallery" data-src={getUrl(images.farLeft, 2000)}>
        <img src={getUrl(images.farLeft)} class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" alt="" />
      </div>
    </div>

    <div class="flex flex-col gap-3 w-[200px] lg:w-[240px] shrink-0 -translate-y-6">
      <div class="aspect-[4/6] rounded-md overflow-hidden shadow-sm cursor-zoom-in" data-fancybox="gallery" data-src={getUrl(images.left, 2000)}>
        <img src={getUrl(images.left)} class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" alt="" />
      </div>
    </div>

    <div class="w-[350px] lg:w-[500px] aspect-[4/5] rounded-md overflow-hidden shadow-2xl z-10 shrink-0 cursor-zoom-in" data-fancybox="gallery" data-src={getUrl(images.center, 2000)}>
      <img src={getUrl(images.center)} class="w-full h-full object-cover hover:scale-105 transition-transform duration-1000" alt="Main View" />
    </div>

    <div class="flex flex-col gap-3 w-[200px] lg:w-[240px] shrink-0 -translate-y-6">
      <div class="aspect-[4/6] rounded-md overflow-hidden shadow-sm cursor-zoom-in" data-fancybox="gallery" data-src={getUrl(images.right, 2000)}>
        <img src={getUrl(images.right)} class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" alt="" />
      </div>
    </div>

    <div class="hidden xl:flex flex-col gap-3 w-[150px] lg:w-[180px] shrink-0 translate-y-10">
      <div class="aspect-square rounded-md overflow-hidden shadow-sm cursor-zoom-in" data-fancybox="gallery" data-src={getUrl(images.farRightBottom, 2000)}>
        <img src={getUrl(images.farRightBottom)} class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" alt="" />
      </div>
    </div>
  </div>

  <div class="md:hidden">
    <div id="grid-gallery-scroll" class="flex gap-4 overflow-x-auto px-6 pb-10 hide-scrollbar snap-x snap-mandatory items-center h-[75vh]">
      {mobileSections.map((section) => (
        <div 
          class={`flex-shrink-0 ${section.size} rounded-md overflow-hidden shadow-lg snap-center cursor-pointer`}
          data-fancybox="gallery-mobile"
          data-src={getUrl(section.id, 2000)}
        >
          <img 
            src={getUrl(section.id)} 
            class="w-full h-full object-cover" 
            alt="Cenote mobile view"
            loading="lazy"
          />
        </div>
      ))}
      <div class="w-[10vw] flex-shrink-0"></div>
    </div>
    <p class="text-center text-gray-400 text-sm italic">{i18n.HOME_PAGE.GALLERY.MOVIL}</p>
  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  .md:hidden #grid-gallery-scroll {
    cursor: grab;
  }
  .md:hidden #grid-gallery-scroll:active {
    cursor: grabbing;
  }
</style>

<script>
  import { Fancybox } from "@fancyapps/ui";
  const initGallery = () => {
    
    Fancybox.bind("[data-fancybox]", {
      Hash: false,
    });

    const slider = document.getElementById("grid-gallery-scroll");
    if (!slider) return;

    let isDown = false;
    let startX: number;
    let scrollLeft: number;

    slider.addEventListener("mousedown", (e) => {
      isDown = true;
      startX = e.pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
      slider.style.scrollSnapType = "none"; 
    });

    slider.addEventListener("mouseleave", () => (isDown = false));
    slider.addEventListener("mouseup", () => {
      isDown = false;
      slider.style.scrollSnapType = "x mandatory";
    });

    slider.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - slider.offsetLeft;
      const walk = (x - startX) * 2;
      slider.scrollLeft = scrollLeft - walk;
    });
  };

  initGallery();
  document.addEventListener("astro:after-swap", initGallery);
</script>