---
import { getI18N } from "@/i18n";
import { getLangFromUrl, useTranslatedPath } from "@/i18n/utils";
import TagH1 from "@/components/global/TagH1.astro";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const Mux_playback_Id = "02O1Y01f9gynt28Ukp95X7DFLyGBQILjyyk8xtjNO0298I";
---

<section class="bg-[#F8FAFC] relative w-full h-screen overflow-hidden">
  <mux-player
    playback-id={Mux_playback_Id}
    autoplay
    muted
    loop
    playsinline
    no-controls
    preload="auto"
    class="absolute inset-0 w-screen h-screen object-cover brightness-[0.4] z-0"
    poster={`https://image.mux.com/${Mux_playback_Id}/thumbnail.webp?time=0&width=1280`}
  ></mux-player>

  <div
    class="max-w-7xl mx-auto relative z-20 text-center text-white px-4 lg:px-6 flex flex-col items-center justify-center h-full gap-8 sm:gap-10 pt-24"
  >
    <div class="flex flex-col gap-4">
      <TagH1
        class="font-serif regular text-3xl sm:text-7xl md:text-7xl lg:text-6xl leading-tight"
      >
        {i18n.HOME_PAGE.HERO.TITLE}
        <span
          class="block not-regular italic text-xl sm:text-2xl md:text-3xl lg:text-4xl lg:mt-10"
        >
          {i18n.HOME_PAGE?.SUBTITLE}
        </span>
      </TagH1>
    </div>
    <div class="flex flex-col items-center gap-8">
      <a
        href={translatePath("/cenotes-cancun/")}
        class="inline-flex items-center justify-center bg-[#006083] hover:bg-[#006083]/90 text-white rounded-md px-12 h-14 uppercase tracking-[0.3em] text-[10px] md:text-xs border border-white/10 transition-all duration-500 shadow-xl font-medium"
      >
        {i18n.HOME_PAGE.HERO.DES}
      </a>
    </div>
  </div>
</section>

<script>
  import("@mux/mux-player");
</script>

<style>
  mux-player {
    width: 100vw;
    height: 100vh;
    --controls: none;
    --media-object-fit: cover;
  }
  mux-player::part(video) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }
</style>
