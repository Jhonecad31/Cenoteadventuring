---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TagH1 from "@/components/global/TagH1.astro";
import BContainer from "@/components/global/BContainer.astro";
import { getI18N } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;

const seoMetaData = {
  title: `${i18n.PRIVACY_POLICY.TITLE} - Cenote Adventuring`,
  description: i18n.PRIVACY_POLICY.P1,
};
---

<BaseLayout seo={seoMetaData}>
  <main class="bg-[#F8FAFC] py-24 md:py-32">
    <BContainer>
      <div class="max-w-4xl mx-auto bg-white p-8 md:p-16 rounded-md shadow-sm border border-slate-200">
        <TagH1 class="font-serif text-3xl md:text-5xl text-[#001524] mb-8 border-b border-slate-100 pb-8">
          {i18n.PRIVACY_POLICY.TITLE}
        </TagH1>
        
        <div class="space-y-8 text-slate-600 font-light leading-relaxed">
          <section class="space-y-4">
            <p>{i18n.PRIVACY_POLICY.P1}</p>
            <p>{i18n.PRIVACY_POLICY.P2}</p>
          </section>

          <section class="space-y-4">
            <h2 class="text-xl font-serif text-[#006083] mb-4">{i18n.PRIVACY_POLICY.WHAT_COLLECT.TITLE}</h2>
            <p>{i18n.PRIVACY_POLICY.WHAT_COLLECT.P1}</p>
            <p>{i18n.PRIVACY_POLICY.WHAT_COLLECT.P2}</p>
            <p>{i18n.PRIVACY_POLICY.WHAT_COLLECT.P3}</p>
          </section>

          <section class="space-y-4">
            <h2 class="text-xl font-serif text-[#006083] mb-4">{i18n.PRIVACY_POLICY.WHAT_USE.TITLE}</h2>
            <p>{i18n.PRIVACY_POLICY.WHAT_USE.P1}</p>
            
            <h3 class="font-medium text-[#001524]">{i18n.PRIVACY_POLICY.WHAT_USE.ESSENTIAL_TITLE}</h3>
            <ul class="list-disc pl-6 space-y-2">
              {i18n.PRIVACY_POLICY.WHAT_USE.ESSENTIAL_LIST.map((item: string) => (
                <li>{item}</li>
              ))}
            </ul>

            <h3 class="font-medium text-[#001524] pt-4">{i18n.PRIVACY_POLICY.WHAT_USE.NON_ESSENTIAL_TITLE}</h3>
            <p>{i18n.PRIVACY_POLICY.WHAT_USE.NON_ESSENTIAL_P}</p>
            <ul class="list-disc pl-6 space-y-2">
              {i18n.PRIVACY_POLICY.WHAT_USE.NON_ESSENTIAL_LIST.map((item: string) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>

          <section class="space-y-4">
            <h2 class="text-xl font-serif text-[#006083] mb-4">{i18n.PRIVACY_POLICY.WHO_SHARE.TITLE}</h2>
            <p>{i18n.PRIVACY_POLICY.WHO_SHARE.P1}</p>
            <p>{i18n.PRIVACY_POLICY.WHO_SHARE.P2}</p>
          </section>

          <section class="space-y-4">
            <h2 class="text-xl font-serif text-[#006083] mb-4">{i18n.PRIVACY_POLICY.LIMIT_USE.TITLE}</h2>
            <p>{i18n.PRIVACY_POLICY.LIMIT_USE.P1}</p>
            <p>{i18n.PRIVACY_POLICY.LIMIT_USE.P2}</p>
          </section>

          <section class="space-y-4">
            <h2 class="text-xl font-serif text-[#006083] mb-4">{i18n.PRIVACY_POLICY.REVOKE_CONSENT.TITLE}</h2>
            <p>{i18n.PRIVACY_POLICY.REVOKE_CONSENT.P1}</p>
            <p>{i18n.PRIVACY_POLICY.REVOKE_CONSENT.P2}</p>
            <ul class="list-disc pl-6 space-y-2">
              {i18n.PRIVACY_POLICY.REVOKE_CONSENT.LIST.map((item: string) => (
                <li>{item}</li>
              ))}
            </ul>
            <p>{i18n.PRIVACY_POLICY.REVOKE_CONSENT.P3}</p>
          </section>

          <section class="space-y-4">
            <h2 class="text-xl font-serif text-[#006083] mb-4">{i18n.PRIVACY_POLICY.AMENDMENTS.TITLE}</h2>
            <p dangerouslySetInnerHTML={{ __html: i18n.PRIVACY_POLICY.AMENDMENTS.P1.replace('info@extremeadventurecancun.com', '<a href="mailto:info@extremeadventurecancun.com" class="text-[#006083] hover:underline">info@extremeadventurecancun.com</a>') }}></p>
          </section>

          <section class="space-y-4 border-b border-slate-100 pb-8">
            <h2 class="text-xl font-serif text-[#006083] mb-4">{i18n.PRIVACY_POLICY.LAW.TITLE}</h2>
            <p>{i18n.PRIVACY_POLICY.LAW.P1}</p>
          </section>
          
          <div class="flex flex-col sm:flex-row sm:justify-between items-start sm:items-center text-sm text-slate-400 mt-8 pt-4 gap-4">
            <p class="italic">{i18n.PRIVACY_POLICY.FOOTER.DATE}</p>
            <p>{i18n.PRIVACY_POLICY.FOOTER.EMAIL}<a href="mailto:info@extremeadventurecancun.com" class="text-[#006083] hover:underline">info@extremeadventurecancun.com</a></p>
          </div>
        </div>
      </div>
    </BContainer>
  </main>
</BaseLayout>
