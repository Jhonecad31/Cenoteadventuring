---
import { getI18N } from "@/i18n";
import TagH1 from "@/components/global/TagH1.astro";
import TagH2 from "@/components/global/TagH2.astro";
import TagP from "@/components/global/TagP.astro";
import { Natgeo, Tripadvaisor, Wordl } from "@/icons/allIcons";

interface Props {
  isPage?: boolean;
}

const { isPage = false } = Astro.props;
const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;

const related_awards = [
  {
    name: "National Geography",
    image: Natgeo,
  },
  {
    name: "World Travel Awards",
    image: Wordl,
  },
  {
    name: "Trip Advisor",
    image: Tripadvaisor,
  },
];
---
<section class="bg-white py-10 md:py-16 px-6 overflow-hidden">
  <div class="max-w-[1200px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-start">
      <div class="lg:max-w-md md:max-w-2xl px-4">
        <div class="w-16 h-[1px] bg-[#006083] mb-6 md:mb-8"></div>
        {
          isPage ? (
            <TagH1 class="font-serif md:text-4xl text-[#001524] leading-[1.2] tracking-tight">
              {i18n.HOME_PAGE.AWARDS.TITLE}
            </TagH1>
          ) : (
            <TagH2 class="font-serif md:text-4xl text-[#001524] leading-[1.2] tracking-tight">
              {i18n.HOME_PAGE.AWARDS.TITLE}
            </TagH2>
          )
        }
      </div>
      <div class="flex flex-col gap-4 px-4 lg:px-0">
        <TagP class="text-[#001524]/60 lg:text-lg md:text-xl leading-[1.6]">
          {i18n.HOME_PAGE.AWARDS.DESCRIPTION1}
        </TagP>
        <TagP class="text-[#001524]/60 lg:text-lg md:text-xl leading-[1.6]">
          {i18n.HOME_PAGE.AWARDS.DESCRIPTION2}
        </TagP>
        <div class="pt-2">
          <a
            href="/about/"
            class="inline-block text-[#005B71] uppercase tracking-[0.2em] text-sm font-bold border-b-2 border-[#005B71]/30 pb-1 hover:border-[#005B71] transition-all duration-300"
          >
            {i18n.HOME_PAGE.AWARDS.DESCRIP_LINK}
          </a>
        </div>
      </div>
    </div>
    <div
      class="grid grid-cols-3 gap-2 sm:gap-8 mt-8 md:mt-16 mx-auto max-w-5xl px-2 sm:px-4"
    >
      {
        related_awards.map((activity) => (
          <div class="flex flex-col items-center text-center p-2 sm:p-6 group">
            <div class="h-12 sm:h-20 w-full flex items-center justify-center mb-2 sm:mb-6 transition-all duration-500 group-hover:scale-110">
              <img
                src={activity.image.src}
                alt={activity.name}
                class="h-full w-auto max-w-[70px] sm:max-w-[180px] object-contain opacity-80 group-hover:opacity-100 transition-all duration-500"
              />
            </div>
            <h3 class="text-[#001524] text-[9px] sm:text-xs md:text-sm tracking-[0.1em] uppercase font-bold leading-tight max-w-[100px] sm:max-w-none">
              {activity.name}
            </h3>
          </div>
        ))
      }
    </div>
  </div>
</section>
<style>
  main {
    scroll-behavior: smooth;
  }
</style>