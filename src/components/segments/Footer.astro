---
import { getI18N } from "@/i18n";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "@/i18n/utils";
import {
  Facebook as FBIcon,
  Instagram as IGIcon,
  Logo_blanco,
} from "@/icons/allIcons";
import { Phone, Mail, MapPin } from "lucide-react";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale }) as any;

const lang = getLangFromUrl(Astro.url);
const k = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const currentYear = new Date().getFullYear();

const navFooter = [
  { title: k("nav.home"), link: translatePath("/") },
  { title: "Blog", link: translatePath("/blog/") },
  { title: k("nav.cenoteTrail"), link: translatePath("/cenote-trail/") },
  { title: k("nav.about"), link: translatePath("/about/") },
  { title: k("nav.contact"), link: translatePath("/contact/") },
];

const socialMedia = [
  {
    title: "Facebook",
    icon: FBIcon,
    link: "https://www.facebook.com/cenoteadventuring/",
  },
  {
    title: "Instagram",
    icon: IGIcon,
    link: "https://www.instagram.com/cenoteadventuring/",
  },
];
---

<footer
  class="bg-[#006083] text-white py-12 md:py-16 px-6 md:px-8 mt-auto w-full border-t border-white/10"
  id="main-footer"
>
  <div
    class="max-w-[1800px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8"
  >
    {/* SECCIÓN DE CONTACTO: Se mantiene primero en el DOM (arriba en móvil) */}
    <div
      class="flex flex-col gap-6 lg:col-span-4 space-y-3 w-full max-w-md mx-auto"
    >
      <h3
        class="font-serif text-lg md:text-xl tracking-[0.2em] uppercase border-b border-white/10 pb-4 w-fit"
      >
        {i18n.HOME_PAGE.FOOTER.TITLE}
      </h3>

      <div class="space-y-3 w-full max-w-md mx-auto">
        <div
          class="border border-white/20 p-3 md:p-5 flex items-center gap-4 hover:bg-white/5 transition-all duration-300 group"
        >
          <div
            class="bg-white text-[#006083] p-2 md:p-2.5 rounded-full shadow-lg shrink-0 group-hover:scale-110 transition-transform"
          >
            <Phone size={18} strokeWidth={2.5} />
          </div>

          <div class="flex flex-col min-w-0">
            <span
              class="text-[11px] md:text-xs uppercase opacity-60 tracking-[0.15em] leading-tight"
            >
              {i18n.HOME_PAGE.FOOTER.DIRECT_LINE}
            </span>
            <a
              href="tel:+529982998131"
              class="text-sm md:text-base tracking-wide font-medium truncate"
            >
              +52 998 299 8131
            </a>
          </div>
        </div>

        <div
          class="border border-white/20 p-3 md:p-5 flex items-center gap-4 hover:bg-white/5 transition-all duration-300 group"
        >
          <div
            class="bg-white text-[#006083] p-2 md:p-2.5 rounded-full shadow-lg shrink-0 group-hover:scale-110 transition-transform"
          >
            <Mail size={18} strokeWidth={2.5} />
          </div>
          <div class="flex flex-col min-w-0">
            <span
              class="text-[11px] md:text-xs uppercase opacity-60 tracking-[0.15em] leading-tight"
            >
              {i18n.HOME_PAGE.FOOTER.RESERVATIONS}
            </span>
            <a
              href="mailto:info@cenoteadventuring.com"
              class="text-sm md:text-base hover:underline break-all md:break-normal font-medium"
            >
              info@cenoteadventuring.com
            </a>
          </div>
        </div>
        <div
          class="border border-white/20 p-3 md:p-5 flex items-center gap-4 hover:bg-white/5 transition-all duration-300 group"
        >
          <div
            class="bg-white text-[#006083] p-2 md:p-2.5 rounded-full shadow-lg shrink-0 group-hover:scale-110 transition-transform"
          >
            <MapPin size={18} strokeWidth={2.5} />
          </div>
          <div class="flex flex-col min-w-0">
            <span
              class="text-[11px] md:text-xs uppercase opacity-60 tracking-[0.15em] leading-tight"
            >
              {i18n.CONTACT_PAGE.INFO.OPTIONS.LOCATION}
            </span>
            <span
              class="text-sm md:text-base font-medium leading-relaxed opacity-90"
            >
              Ruta de los Cenotes, Q.R. Puerto Morelos - Leona Vicario KM
              19.1,77580.
            </span>
          </div>
        </div>
      </div>
    </div>

    {/* SECCIÓN DE LOGO Y NAVEGACIÓN */}
    <div
      class="lg:col-span-8 flex flex-row flex-wrap items-start gap-y-10 lg:pl-12"
    >
      <div class="w-full lg:w-auto flex justify-center lg:block lg:mt-35">
        <a href={translatePath("/")} class="block hover:scale-105 transition-transform duration-300">
          <Logo_blanco class="h-20 lg:h-28 w-auto opacity-90" />
        </a>
      </div>

      <div
        class="flex flex-col gap-4 w-1/2 lg:w-auto lg:w-full lg:max-w-md lg:mx-auto items-center lg:items-start text-center lg:text-left relative z-10"
      >
          <h3
            class="font-serif text-sm md:text-lg tracking-[0.1em] uppercase border-b border-white/10 pb-2 w-fit"
          >
            {i18n.HOME_PAGE.FOOTER.TRADUCTION.ABOUT}
          </h3>
          <nav class="mt-2">
            <ul
              class="flex flex-col gap-3 text-[11px] md:text-sm uppercase tracking-[0.15em] font-light items-center lg:items-start"
            >
              {
                navFooter.map((item) => (
                  <li>
                    <a
                      href={item.link}
                      class="hover:text-cyan-300 transition-colors"
                    >
                      {item.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

      <div
        class="flex flex-col gap-4 items-center lg:items-end space-y-2 w-1/2 lg:w-5xl lg:-mt-80 text-center lg:text-right"
      >
          <h3
            class="font-serif text-sm md:text-lg tracking-[0.1em] uppercase border-b border-white/10 pb-2 w-fit"
          >
            {i18n.HOME_PAGE.FOOTER.TRADUCTION.FOLLOW}
          </h3>
          <ul class="flex flex-col gap-4 mt-2 items-center lg:items-start">
            {
              socialMedia.map(({ title, icon: Icon, link }) => (
                <li>
                  <a
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 group"
                  >
                    <Icon
                      size={20}
                      className="group-hover:scale-110 transition-transform"
                    />
                    <span class="text-[11px] md:text-sm uppercase tracking-[0.1em] group-hover:opacity-70 transition-opacity">
                      {title}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
    </div>

    <div class="lg:col-span-12 mt-10 grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-4 flex flex-col gap-6">
        <div class="border-t border-white/10 w-full"></div>

        <div
          class="text-[10px] md:text-xs uppercase tracking-[0.2em] text-white/40 text-center lg:text-left flex flex-col gap-2"
        >
          <p>© {currentYear} Cenote Adventuring Cancun. All Rights Reserved.</p>
          <p class="text-white/20">Design By Grupo Extreme</p>
        </div>
      </div>

      <div class="lg:col-span-8 flex flex-col gap-6 lg:pl-12">
        <div class="border-t border-white/10 w-full"></div>

        <div
          class="flex flex-wrap justify-center lg:justify-start items-center gap-6 md:gap-10 text-[10px] md:text-xs uppercase tracking-[0.2em] text-white/40 font-medium h-full"
        >
          <a href={translatePath("/privacy-policy/")} class="hover:text-white transition-colors"
            >Privacy Policy</a
          >
          <a href={translatePath("/terms-conditions/")} class="hover:text-white transition-colors"
            >Terms & Conditions</a
          >
        </div>
      </div>
    </div>
  </div>
</footer>
